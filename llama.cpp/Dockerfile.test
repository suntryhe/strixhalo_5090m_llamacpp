# llamacpp-latest 双后端测试镜像 (与生产 baseline 同形态: Fedora43 + ROCm 7.2.4 + CUDA 13.2)
# 源码: llamacpp-latest = 最新 mainline a94d563 + 全部调优 (dspark + UMA + occ2 + 降块)
# 双后端: -DGGML_CUDA=ON -DGGML_HIP=ON (验证 -dev CUDA0,ROCm0)

FROM registry.fedoraproject.org/fedora:43

# 基础工具
RUN rm -rf /var/cache/dnf/* /var/lib/dnf/* && \
  dnf install -y --nodocs --setopt=install_weak_deps=False --disablerepo=updates \
  sudo dnf-plugins-core git-core wget curl cmake ninja-build \
  make rsync patch clang clang-devel lld compiler-rt && \
  dnf clean all && rm -rf /var/cache/dnf/* /var/lib/dnf/*

# ROCm 7.2.4 (与生产 baseline 一致)
RUN tee /etc/yum.repos.d/rocm.repo <<'REPO'
[ROCm-7.2.4]
name=ROCm 7.2.4
baseurl=https://repo.radeon.com/rocm/rhel10/7.2.4/main
enabled=1
priority=50
gpgcheck=1
gpgkey=https://repo.radeon.com/rocm/rocm.gpg.key
REPO

RUN dnf -y --nodocs --setopt=install_weak_deps=False \
  --disablerepo=updates \
  --exclude='*sdk*' --exclude='*samples*' --exclude='*-doc*' --exclude='*-docs*' \
  install \
  rocm-llvm rocm-device-libs hip-runtime-amd hip-devel rocwmma-devel \
  rocblas rocblas-devel hipblas hipblas-devel rocm-cmake libomp-devel libomp \
  rocminfo rdma-core-devel && \
  dnf clean all && rm -rf /var/cache/dnf/*

# CUDA 仓库 + 工具链 (与 baseline 一致: CUDA 13.2)
RUN tee /etc/yum.repos.d/cuda-fedora.repo <<'CUDA'
[cuda-fedora]
name=CUDA Fedora Repository
baseurl=https://developer.download.nvidia.com/compute/cuda/repos/fedora43/x86_64/
enabled=1
gpgcheck=1
gpgkey=https://developer.download.nvidia.cn/compute/cuda/repos/fedora43/x86_64/1940C73E.pub
CUDA

RUN dnf -y --nodocs --setopt=install_weak_deps=False --disablerepo=updates install \
  cuda-toolkit && \
  dnf clean all && rm -rf /var/cache/dnf/*

ENV ROCM_PATH=/opt/rocm \
    HIP_PLATFORM=amd \
    HIP_PATH=/opt/rocm \
    HIP_CLANG_PATH=/opt/rocm/llvm/bin \
    HIP_DEVICE_LIB_PATH=/opt/rocm/amdgcn/bitcode \
    CUDA_PATH=/usr/local/cuda \
    PATH="/opt/rocm/bin:/opt/rocm/llvm/bin:/usr/local/cuda/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/rocm/lib:/opt/rocm/llvm/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}" \
    CMAKE_PREFIX_PATH="/opt/rocm;/opt/rocm/lib64/cmake;/usr/local/cuda" \
    CUDACXX=/usr/local/cuda/bin/nvcc \
    CUDA_HOST_COMPILER=/usr/bin/gcc

# 复制最新树源码
COPY . /src/

# 编译双后端 (CUDA 120 + gfx1151, 与生产 baseline 一致)
RUN echo "🔨 编译 llamacpp-latest (dspark+调优) CUDA+ROCm 双后端..." \
  && cd /src \
  && git submodule update --recursive || true \
  && rm -rf build \
  && cmake -B build \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_EXE_LINKER=lld \
    -DCMAKE_MODULE_LINKER=lld \
    -DCMAKE_SHARED_LINKER=lld \
    -DGGML_CUDA=ON \
    -DGGML_HIP=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_NATIVE=OFF \
    -DGGML_RPC=ON \
    -DGGML_CUDA_NO_PEER_COPY=ON \
    -DCMAKE_CUDA_ARCHITECTURES=120 \
    -DAMDGPU_TARGETS=gfx1151 \
    -DCMAKE_BUILD_TYPE=Release \
    -DROCM_PATH=/opt/rocm \
    -DHIP_PATH=/opt/rocm \
    -DHIP_PLATFORM=amd \
    -DLLAMA_UI=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
  && cmake --build build --config Release --target llama-cli llama-server llama-bench -j$(nproc) \
  && (cmake --install build --config Release || true) \
  && find build -type f -name 'lib*.so*' -exec cp -f {} /usr/local/lib64/ \; \
  && echo "/usr/local/lib64" > /etc/ld.so.conf.d/llama.conf \
  && echo "/opt/rocm/lib" >> /etc/ld.so.conf.d/llama.conf \
  && echo "/opt/rocm/llvm/lib" >> /etc/ld.so.conf.d/llama.conf \
  && echo "/usr/local/cuda/lib64" >> /etc/ld.so.conf.d/llama.conf \
  && ldconfig \
  && mkdir -p /usr/local/bin \
  && cp -f /src/build/bin/llama-server /usr/local/bin/llama-server \
  && cp -f /src/build/bin/llama-cli /usr/local/bin/llama-cli \
  && cp -f /src/build/bin/llama-bench /usr/local/bin/llama-bench \
  && cp -f /usr/local/lib64/libllama*.so* /usr/lib64/ 2>/dev/null || true \
  && ldconfig \
  && rm -rf /src/build \
  && echo "✅ 双后端测试镜像编译完成"

ENV GGML_CUDA=1 \
    GGML_HIP=1 \
    GGML_BACKEND_DL=1

WORKDIR /app
CMD ["llama-server", "--host", "0.0.0.0", "--port", "8082", "--ctx-size", "4096", "--n-gpu-layers", "all"]